<Window x:Class="ClientSide.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientSide"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label Content="Log in" HorizontalAlignment="Center" Margin="0,0,0,10" VerticalAlignment="Top" FontWeight="Bold" FontSize="24"/>
            <StackPanel Orientation="Horizontal">
                <Label Content="Username:" HorizontalAlignment="Center" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBox Name="usernameInput" HorizontalAlignment="Center" Margin="0,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="120"/>
            </StackPanel>
            
            <Button Content="Enter" HorizontalAlignment="Center" Margin="0,10,0,0" Click="Button_ClickAsync"/>
        </StackPanel>
        

    </Grid>
</Window>
