<Window x:Class="ClientSide.GeneralLobby"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientSide"
        xmlns:local1="clr-namespace:SharedContracts;assembly=SharedContracts"
        mc:Ignorable="d"
        Title="GeneralLobby" Height="450" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Stretch"
                      Background="Black"
                      ShowsPreview="True"
                      Width="5"/>

        <!-- Right: room chat goes here -->
        <ContentControl Grid.Column="1" Name="lobbyChatContent" Content="" />

        <!-- Left: lobby controls/list -->
        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="8">
            <Label Content="Lobby rooms" FontWeight="Bold" HorizontalAlignment="Center"/>

            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,6">
                <Button Content="Log out" HorizontalAlignment="Center" Click="LogOutButton_Click"/>
                <Button Content="Create room" HorizontalAlignment="Center" Click="CreateRoomPopup_Click"/>
                <Popup Name="createRoomPopup" IsOpen="false" AllowsTransparency="True" StaysOpen="False">
                    <Border Background="White" BorderBrush="Black" BorderThickness="1" Padding="8">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Label Content="Room name:" Width="100" />
                                <TextBox Name="roomNameInput" Width="140"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Label Content="Room capacity:" Width="100" />
                                <TextBox Name="roomCapacityInput" Width="100"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Is ranked:" Width="100" />
                                <CheckBox Name="isRankedInput"/>
                            </StackPanel>
                            <Button Name="createRoomButton" Content="Create room" Click="CreateRoomButton_Click" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button Content="Join room" HorizontalAlignment="Center" Click="JoinRoomButton_Click"/>
            </UniformGrid>

            <!-- Status line -->
            <TextBlock x:Name="StatusText" Foreground="DarkRed" Margin="0,0,0,6"/>

            <ListBox Name="listOfLobbies">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local1:LobbyRoomInfo}">
                        <TextBlock Text="{Binding RoomName}" FontWeight="Bold"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Window>
