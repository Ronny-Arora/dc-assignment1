<UserControl x:Class="ClientSide.LobbyRoomChat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local1="clr-namespace:SharedContracts;assembly=SharedContracts"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="980">

    <Grid>
        <!-- Top: players / chat / files -->
        <Grid Margin="8" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="6"/>
                <!-- splitter gutter -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <!-- splitter gutter -->
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
                <!-- status -->
            </Grid.RowDefinitions>

            <!-- Players pane -->
            <DockPanel Grid.Column="0" Grid.RowSpan="2" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Players" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                    <Button Content="DM Player" Click="MessagePlayerButton_Click" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="6">
                    <ListBox x:Name="listOfPlayers" Margin="4"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Border>
            </DockPanel>

            <!-- Splitter left -->
            <GridSplitter Grid.Column="1" Grid.RowSpan="2"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#FFE6E6E6" Width="6" />

            <!-- Chat pane -->
            <DockPanel Grid.Column="2" LastChildFill="True">
                <TextBlock x:Name="lobbyRoomLabel"
                           DockPanel.Dock="Top"
                           Text="Lobby Room: "
                           FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6">
                    <ListBox x:Name="lobbyMessages" Margin="4"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local1:ChatMessage}">
                                <StackPanel Orientation="Vertical" Margin="0,4">
                                    <TextBlock Text="{Binding Sender}" FontWeight="SemiBold"/>
                                    <Border CornerRadius="6" Padding="8" Background="#FF6495ED" >
                                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{Binding TimestampUtc}"
                                               FontSize="11" Foreground="#99000000"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <!-- Status line under chat -->
                <TextBlock x:Name="statusText"
                           DockPanel.Dock="Bottom"
                           Height="22"
                           VerticalAlignment="Center"
                           Foreground="#CCB00000"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <!-- Splitter right -->
            <GridSplitter Grid.Column="3" Grid.RowSpan="2"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#FFE6E6E6" Width="6" />

            <!-- Files pane -->
            <DockPanel Grid.Column="4" Grid.RowSpan="2" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="Shared Files" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                    <Button Content="Share file" Click="ShareFileButton_Click" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="6">
                    <ListBox x:Name="lobbyFiles" Margin="4"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Border>
            </DockPanel>
        </Grid>

        <!-- Bottom send bar -->
        <!-- FIX: Remove Padding from Grid, wrap contents in a Border for padding -->
        <Border VerticalAlignment="Bottom" Background="#FFF9F9F9" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="96"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto" MinWidth="96"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Leave room" Click="LeaveRoomButton_Click" />
                <TextBox Grid.Column="2" x:Name="messageInput" MinHeight="28" />
                <Button Grid.Column="4" Content="Send" Click="SendMessageButton_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
