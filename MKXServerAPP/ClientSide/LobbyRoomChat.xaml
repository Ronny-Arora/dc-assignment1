<UserControl x:Class="ClientSide.LobbyRoomChat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local1="clr-namespace:SharedContracts;assembly=SharedContracts"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid Name="ChattingElements" HorizontalAlignment="Stretch" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Players -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0">
                <Label Content="Players" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Button Content="DM Player" HorizontalAlignment="Center" Click="MessagePlayerButton_Click" Margin="0,0,0,6"/>
                <ListBox Name="listOfPlayers"/>
            </StackPanel>

            <!-- Chat -->
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,8,0">
                <Label Name="lobbyRoomLabel" Content="Lobby Room:" FontWeight="Bold" HorizontalAlignment="Center"/>
                <ListBox Name="lobbyMessages" VerticalAlignment="Stretch" Height="300">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local1:ChatMessage}">
                            <StackPanel Orientation="Vertical" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Sender}" FontWeight="Bold"/>
                                <Border Background="CornflowerBlue" CornerRadius="5" Padding="5" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Text="{Binding TimestampUtc}" FontStyle="Italic" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="statusText" Foreground="DarkRed" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Files -->
            <StackPanel Grid.Column="2" Orientation="Vertical">
                <Label Content="Shared Files" FontWeight="Bold" HorizontalAlignment="Center"/>
                <UniformGrid Rows="1" Columns="2" Margin="0,0,0,6">
                    <Button Content="Share file" HorizontalAlignment="Center" Click="ShareFileButton_Click"/>
                    <Button Content="Download file" HorizontalAlignment="Center" Click="DownloadFileButton_Click"/>
                </UniformGrid>

                <ListBox Name="lobbyFiles" VerticalAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local1:SharedFile}">
                            <StackPanel Orientation="Vertical" Margin="0,0,0,6">
                                <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Uploader}" FontSize="11" Foreground="Gray"/>
                                <TextBlock Text="{Binding SizeBytes}" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Toast for private-message notifications -->
            <Popup x:Name="pmToast"
                   Placement="Top"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,12,12,0"
                   IsOpen="False">
                <Border Background="#DD222222" CornerRadius="8" Padding="10" BorderBrush="#66000000" BorderThickness="1">
                    <TextBlock x:Name="pmToastText" Foreground="White" FontWeight="SemiBold"/>
                </Border>
            </Popup>

        </Grid>

        <!-- Bottom send bar -->
        <Grid Name="SendMessageGrid" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="90"/>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="60"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Leave room" Click="LeaveRoomButton_Click"/>
            <TextBox Name="messageInput" Grid.Column="1" Margin="8,0"/>
            <Button Grid.Column="2" Content="Send" Click="SendMessageButton_Click"/>
        </Grid>
    </Grid>
</UserControl>
